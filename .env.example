# --- Application ---
APP_NAME="Digital Wallet & Transaction Processing Platform"
DEBUG=false

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg2://wallet:wallet@localhost:5432/wallet_db

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# --- Payment simulation ---
AUTO_PROCESS_PAYMENTS=true
ALLOW_SIMULATION=true

# --- Scheduled processing ---
PENDING_DEPOSIT_TIMEOUT_MINUTES=30
PENDING_REVIEW_TIMEOUT_HOURS=72
MAX_RETRY_ATTEMPTS=3

# --- Seed super admin (python -m scripts.seed) ---
SEED_ADMIN_EMAIL=superadmin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# --- Optional: Celery / Redis ---
REDIS_URL=redis://localhost:6379/0
